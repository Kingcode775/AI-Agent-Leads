        "responseMode": "responseNode",
        "options": {}
      },
      "id": "886ac343-6394-41b5-8902-ae3e9af035ae",
      "name": "🔗 Webhook — Créer facture",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        464
      ],
      "webhookId": "fc59a9f6-fedb-4d17-b6a8-a14f5a66f83c"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"processing\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "031498d0-dec8-48b8-82b4-b98a987258f7",
      "name": "📤 Répondre 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        224,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Accepter les données du devis depuis le webhook ou manuellement\nconst devis = body.devis || body;\nconst today = new Date().toLocaleDateString('fr-FR');\nconst isoDate = new Date().toISOString().split('T')[0];\nconst factureNum = 'FACT-' + Date.now().toString().slice(-6);\n\n// Données artisan (à configurer ou passées via webhook)\nconst artisan = {\n  nom: devis.artisan?.nom || body.artisan_nom || 'Artisan KC Peak',\n  siret: devis.artisan?.siret || body.siret || 'SIRET_A_COMPLETER',\n  adresse: devis.artisan?.adresse || body.artisan_adresse || 'Adresse artisan',\n  email: devis.artisan?.email || body.artisan_email || 'artisan@email.com',\n  telephone: devis.artisan?.telephone || body.telephone || ''\n};\n\nconst client = {\n  nom: devis.client?.nom || body.client_nom || 'Client',\n  siret: devis.client?.siret || body.client_siret || '',\n  adresse: devis.client?.adresse || body.client_adresse || '',\n  email: devis.client?.email || body.client_email || ''\n};\n\nconst lignes = devis.lignes || body.lignes || [\n  {\n    designation: devis.description_chantier || 'Travaux selon devis',\n    quantite: 1,\n    unite: 'forfait',\n    prix_unitaire_ht: devis.sous_total_ht || 0,\n    total_ht: devis.sous_total_ht || 0\n  }\n];\n\nconst sousTotal = lignes.reduce((acc, l) => acc + parseFloat(l.total_ht || 0), 0);\nconst tvaTaux = devis.tva_taux || 10;\nconst tvaMontant = Math.round(sousTotal * (tvaTaux / 100) * 100) / 100;\nconst totalTTC = Math.round((sousTotal + tvaMontant) * 100) / 100;\n\nreturn [{\n  json: {\n    factureNum,\n    dateFacture: today,\n    isoDate,\n    echeance: new Date(Date.now() + 30*24*60*60*1000).toLocaleDateString('fr-FR'),\n    artisan,\n    client,\n    lignes,\n    sousTotal,\n    tvaTaux,\n    tvaMontant,\n    totalTTC,\n    devisRef: devis.numero || body.devis_numero || 'N/A',\n    description: devis.description_chantier || body.description || 'Travaux'\n  }\n}];"
      },
      "id": "279d29d3-ee84-488f-ae64-448e9c1265a7",
      "name": "⚙️ Préparer données facture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\n// ========================================\n// GÉNÉRATION FACTUR-X (format légal 2026)\n// Standard européen EN 16931 — Profil MINIMUM\n// ========================================\nconst facturX = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rsm:CrossIndustryInvoice \n  xmlns:rsm=\"urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100\"\n  xmlns:ram=\"urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100\"\n  xmlns:udt=\"urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100\">\n\n  <rsm:ExchangedDocumentContext>\n    <ram:GuidelineSpecifiedDocumentContextParameter>\n      <ram:ID>urn:factur-x.eu:1p0:minimum</ram:ID>\n    </ram:GuidelineSpecifiedDocumentContextParameter>\n  </rsm:ExchangedDocumentContext>\n\n  <rsm:ExchangedDocument>\n    <ram:ID>${d.factureNum}</ram:ID>\n    <ram:TypeCode>380</ram:TypeCode>\n    <ram:IssueDateTime>\n      <udt:DateTimeString format=\"102\">${d.isoDate.replace(/-/g, '')}</udt:DateTimeString>\n    </ram:IssueDateTime>\n  </rsm:ExchangedDocument>\n\n  <rsm:SupplyChainTradeTransaction>\n\n    <ram:ApplicableHeaderTradeAgreement>\n      <ram:SellerTradeParty>\n        <ram:Name>${d.artisan.nom}</ram:Name>\n        <ram:SpecifiedLegalOrganization>\n          <ram:ID schemeID=\"0002\">${d.artisan.siret}</ram:ID>\n        </ram:SpecifiedLegalOrganization>\n        <ram:PostalTradeAddress>\n          <ram:LineOne>${d.artisan.adresse}</ram:LineOne>\n          <ram:CountryID>FR</ram:CountryID>\n        </ram:PostalTradeAddress>\n        <ram:URIUniversalCommunication>\n          <ram:URIID schemeID=\"EM\">${d.artisan.email}</ram:URIID>\n        </ram:URIUniversalCommunication>\n      </ram:SellerTradeParty>\n\n      <ram:BuyerTradeParty>\n        <ram:Name>${d.client.nom}</ram:Name>\n        ${d.client.siret ? `<ram:SpecifiedLegalOrganization><ram:ID schemeID=\"0002\">${d.client.siret}</ram:ID></ram:SpecifiedLegalOrganization>` : ''}\n        <ram:PostalTradeAddress>\n          <ram:LineOne>${d.client.adresse}</ram:LineOne>\n          <ram:CountryID>FR</ram:CountryID>\n        </ram:PostalTradeAddress>\n        <ram:URIUniversalCommunication>\n          <ram:URIID schemeID=\"EM\">${d.client.email}</ram:URIID>\n        </ram:URIUniversalCommunication>\n      </ram:BuyerTradeParty>\n\n      <ram:BuyerOrderReferencedDocument>\n        <ram:IssuerAssignedID>${d.devisRef}</ram:IssuerAssignedID>\n      </ram:BuyerOrderReferencedDocument>\n    </ram:ApplicableHeaderTradeAgreement>\n\n    <ram:ApplicableHeaderTradeDelivery/>\n\n    <ram:ApplicableHeaderTradeSettlement>\n      <ram:InvoiceCurrencyCode>EUR</ram:InvoiceCurrencyCode>\n      <ram:SpecifiedTradeSettlementHeaderMonetarySummation>\n        <ram:LineTotalAmount>${d.sousTotal.toFixed(2)}</ram:LineTotalAmount>\n        <ram:TaxBasisTotalAmount>${d.sousTotal.toFixed(2)}</ram:TaxBasisTotalAmount>\n        <ram:TaxTotalAmount currencyID=\"EUR\">${d.tvaMontant.toFixed(2)}</ram:TaxTotalAmount>\n        <ram:GrandTotalAmount>${d.totalTTC.toFixed(2)}</ram:GrandTotalAmount>\n        <ram:DuePayableAmount>${d.totalTTC.toFixed(2)}</ram:DuePayableAmount>\n      </ram:SpecifiedTradeSettlementHeaderMonetarySummation>\n    </ram:ApplicableHeaderTradeSettlement>\n\n  </rsm:SupplyChainTradeTransaction>\n</rsm:CrossIndustryInvoice>`;\n\n// ========================================\n// GÉNÉRATION HTML FACTURE (pour email)\n// ========================================\nconst lignesHTML = d.lignes.map(l => `\n  <tr>\n    <td style=\"padding:10px;border-bottom:1px solid #eee;\">${l.designation}</td>\n    <td style=\"padding:10px;border-bottom:1px solid #eee;text-align:center;\">${l.quantite}</td>\n    <td style=\"padding:10px;border-bottom:1px solid #eee;text-align:center;\">${l.unite}</td>\n    <td style=\"padding:10px;border-bottom:1px solid #eee;text-align:right;\">${parseFloat(l.prix_unitaire_ht).toFixed(2)} €</td>\n    <td style=\"padding:10px;border-bottom:1px solid #eee;text-align:right;font-weight:bold;\">${parseFloat(l.total_ht).toFixed(2)} €</td>\n  </tr>\n`).join('');\n\nconst htmlFacture = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head><meta charset=\"UTF-8\"><title>Facture ${d.factureNum}</title></head>\n<body style=\"font-family:Arial,sans-serif;max-width:800px;margin:0 auto;padding:20px;color:#333;\">\n\n  <div style=\"background:#1a1a2e;color:white;padding:20px;border-radius:8px;margin-bottom:25px;display:flex;justify-content:space-between;align-items:center;\">\n    <div>\n      <h1 style=\"margin:0;font-size:32px;\">FACTURE</h1>\n      <p style=\"margin:5px 0;opacity:0.8;\">Conforme Factur-X — Réforme 2026</p>\n    </div>\n    <div style=\"text-align:right;\">\n      <p style=\"margin:0;font-size:18px;\"><strong>N° ${d.factureNum}</strong></p>\n      <p style=\"margin:3px 0;opacity:0.8;\">Date : ${d.dateFacture}</p>\n      <p style=\"margin:3px 0;opacity:0.8;\">Échéance : ${d.echeance}</p>\n    </div>\n  </div>\n\n  <div style=\"display:flex;justify-content:space-between;margin-bottom:25px;\">\n    <div style=\"background:#f0f0f0;padding:15px;border-radius:8px;width:45%;\">\n      <h3 style=\"margin:0 0 10px;color:#1a1a2e;\">🔨 Émetteur</h3>\n      <p style=\"margin:3px 0;\"><strong>${d.artisan.nom}</strong></p>\n      <p style=\"margin:3px 0;color:#666;\">SIRET : ${d.artisan.siret}</p>\n      <p style=\"margin:3px 0;color:#666;\">${d.artisan.adresse}</p>\n      <p style=\"margin:3px 0;color:#666;\">✉️ ${d.artisan.email}</p>\n    </div>\n    <div style=\"background:#f0f0f0;padding:15px;border-radius:8px;width:45%;\">\n      <h3 style=\"margin:0 0 10px;color:#1a1a2e;\">👤 Destinataire</h3>\n      <p style=\"margin:3px 0;\"><strong>${d.client.nom}</strong></p>\n      ${d.client.siret ? `<p style=\"margin:3px 0;color:#666;\">SIRET : ${d.client.siret}</p>` : ''}\n      <p style=\"margin:3px 0;color:#666;\">${d.client.adresse}</p>\n      <p style=\"margin:3px 0;color:#666;\">✉️ ${d.client.email}</p>\n    </div>\n  </div>\n\n  <div style=\"background:#fff3cd;padding:12px;border-radius:6px;border-left:4px solid #ffc107;margin-bottom:20px;\">\n    <strong>📋 Référence devis :</strong> ${d.devisRef} — ${d.description}\n  </div>\n\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:20px;\">\n    <thead>\n      <tr style=\"background:#1a1a2e;color:white;\">\n        <th style=\"padding:12px;text-align:left;\">Désignation</th>\n        <th style=\"padding:12px;text-align:center;\">Qté</th>\n        <th style=\"padding:12px;text-align:center;\">Unité</th>\n        <th style=\"padding:12px;text-align:right;\">P.U. HT</th>\n        <th style=\"padding:12px;text-align:right;\">Total HT</th>\n      </tr>\n    </thead>\n    <tbody>${lignesHTML}</tbody>\n  </table>\n\n  <div style=\"text-align:right;margin-bottom:25px;\">\n    <table style=\"margin-left:auto;min-width:300px;\">\n      <tr style=\"background:#f8f9fa;\">\n        <td style=\"padding:8px 20px;\">Sous-total HT :</td>\n        <td style=\"padding:8px 20px;text-align:right;font-weight:bold;\">${d.sousTotal.toFixed(2)} €</td>\n      </tr>\n      <tr>\n        <td style=\"padding:8px 20px;\">TVA (${d.tvaTaux}%) :</td>\n        <td style=\"padding:8px 20px;text-align:right;\">${d.tvaMontant.toFixed(2)} €</td>\n      </tr>\n      <tr style=\"background:#1a1a2e;color:white;\">\n        <td style=\"padding:12px 20px;font-size:16px;\"><strong>TOTAL TTC</strong></td>\n        <td style=\"padding:12px 20px;text-align:right;font-size:20px;\"><strong>${d.totalTTC.toFixed(2)} €</strong></td>\n      </tr>\n    </table>\n  </div>\n\n  <div style=\"background:#d4edda;border:1px solid #c3e6cb;padding:15px;border-radius:8px;margin-bottom:20px;\">\n    <h4 style=\"margin:0 0 8px;color:#155724;\">✅ Facture conforme Factur-X</h4>\n    <p style=\"margin:0;color:#155724;font-size:14px;\">Cette facture respecte la réglementation française de facturation électronique (réforme 2026). Le fichier XML Factur-X est joint à cet email.</p>\n  </div>\n\n  <div style=\"background:#f8f9fa;padding:15px;border-radius:8px;\">\n    <h4 style=\"margin:0 0 8px;\">💳 Modalités de paiement</h4>\n    <p style=\"margin:0;color:#555;\">Paiement à réception de facture. Échéance : <strong>${d.echeance}</strong></p>\n    <p style=\"margin:5px 0 0;color:#999;font-size:12px;\">En cas de retard : pénalités de 3x le taux d'intérêt légal + indemnité forfaitaire de 40€</p>\n  </div>\n\n  <p style=\"text-align:center;color:#999;font-size:12px;margin-top:25px;\">Facture générée automatiquement par KC Peak IA • Conforme EN 16931 Factur-X Minimum • ${d.dateFacture}</p>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    ...d,\n    facturX,\n    htmlFacture\n  }\n}];"
      },
