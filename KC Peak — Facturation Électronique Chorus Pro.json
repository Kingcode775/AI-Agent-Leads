    {
      "parameters": {
        "jsCode": "// Vérifier si c'est une facture B2G (client = administration publique)\n// Dans ce cas, soumettre directement à Chorus Pro via API PISTE\nconst d = $input.first().json;\n\n// SIRET commençant par certains codes = secteur public\nconst isPublicSector = d.client.siret && (\n  d.client.siret.startsWith('1') || // État\n  d.client.siret.startsWith('2') || // Collectivités\n  d.client.siret.startsWith('3')    // Hôpitaux\n);\n\nreturn [{\n  json: {\n    ...d,\n    isPublicSector,\n    chorusProUrl: 'https://portail.chorus-pro.gouv.fr',\n    pisteApiUrl: 'https://sandbox-api.piste.gouv.fr/chorus-pro/api/v1',\n    message: isPublicSector \n      ? 'Client secteur public détecté — dépôt Chorus Pro recommandé'\n      : 'Client privé — envoi email direct suffisant pour 2026'\n  }\n}];"
      },
      "id": "4f3bc8d6-5cb3-40b5-94c1-f52dd984db00",
      "name": "🏛️ Vérifier si Chorus Pro requis",
