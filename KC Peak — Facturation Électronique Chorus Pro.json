    {
      "parameters": {
        "jsCode": "// Soumettre la facture XML à Chorus Pro via l'API PISTE\n// Documentation : https://developer.aife.economie.gouv.fr\nconst token = $input.first().json.access_token;\nconst factureData = $('🏛️ Vérifier si Chorus Pro requis').first().json;\n\n// Encoder le XML en base64\nconst xmlBase64 = Buffer.from(factureData.facturX, 'utf-8').toString('base64');\n\nreturn [{\n  json: {\n    token,\n    payload: {\n      listeFactures: [\n        {\n          numeroFactureSaisi: factureData.factureNum,\n          codeDestinataire: factureData.client.siret,\n          denomination: factureData.client.nom,\n          idStructureValideur: factureData.client.siret,\n          designationUniteExecutante: 'Service comptabilité',\n          syntaxeFlux: 'IN_DP_E2_UBL_INVOICE_2_1',\n          modeDepot: 'SAISIE_API',\n          fichierFluxFacture: xmlBase64,\n          nomFichierFluxFacture: `${factureData.factureNum}.xml`\n        }\n      ]\n    },\n    factureData\n  }\n}];"
      },
      "id": "1b00df54-6fbc-4a21-a893-3b22e043526a",
