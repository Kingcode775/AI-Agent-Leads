      "id": "e24c0550-5055-4a5f-a356-12a0cf945bfe",
      "name": "🔑 Auth PISTE (Chorus Pro API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1552,
        464
